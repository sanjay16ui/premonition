# PREMONITION Environment Configuration
# Copy this file to .env and adjust values for your machine.
#
# Windows:  copy .env.example .env
# Linux:    cp .env.example .env

# ── Paths ─────────────────────────────────────────────────────────────────────
PREMONITION_DATA_RAW=./data/raw
PREMONITION_DATA_PROCESSED=./data/processed
PREMONITION_MODELS_DIR=./models/artifacts
PREMONITION_REPORTS_DIR=./reports
PREMONITION_LOGS_DIR=./logs

# ── Dataset ───────────────────────────────────────────────────────────────────
PREMONITION_DATASET=dataset.csv
PREMONITION_TARGET=sepsis_label

# ── Model ─────────────────────────────────────────────────────────────────────
PREMONITION_TIER=t1
PREMONITION_MODEL=xgboost
PREMONITION_RANDOM_STATE=42

# ── Logging ───────────────────────────────────────────────────────────────────
PREMONITION_LOG_LEVEL=INFO
PREMONITION_LOG_FILE=./logs/premonition.log
PREMONITION_LOG_JSON=false

# ── API ───────────────────────────────────────────────────────────────────────
PREMONITION_API_HOST=0.0.0.0
PREMONITION_API_PORT=8000

# ── Security & Auth ───────────────────────────────────────────────────────────
# Legacy single API key (optional — use managed keys via /auth/api-keys in prod)
# PREMONITION_API_KEY=change-me-in-production
# JWT secret (required for production auth)
# PREMONITION_JWT_SECRET=generate-a-long-random-secret-here
# PREMONITION_JWT_ACCESS_MINUTES=30
# PREMONITION_JWT_REFRESH_DAYS=7
# Comma-separated CORS origins (default: *)
# PREMONITION_CORS_ORIGINS=http://localhost:5173,https://premonition.health

# ── Docker overrides (used by docker-compose.yml) ─────────────────────────────
# PREMONITION_DATA_RAW=/app/data/raw
# PREMONITION_MODELS_DIR=/app/models/artifacts

# ── OTP Email Verification (Resend) ───────────────────────────────────────────
# Sign up at https://resend.com — free tier supports 3,000 emails/month
# Without this key, OTPs are printed to the server console (dev mode)
# RESEND_API_KEY=re_your_resend_api_key_here
# Sender email (must be verified in Resend dashboard, or use sandbox below)
# RESEND_FROM_EMAIL=onboarding@resend.dev       ← Resend sandbox (no verification needed)
# RESEND_FROM_EMAIL=noreply@yourdomain.com      ← Production (requires verified domain)
